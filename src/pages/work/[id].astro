---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.jsx';
import Footer from '../../components/Footer.jsx';
import { projectsData } from '../../data/projects.js';

export function getStaticPaths() {
  return projectsData.map(project => ({
    params: { id: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Sivarya`}>
  <Navbar client:load />

  <main class="bg-white min-h-screen">

    <!-- HERO -->
    <section class="relative h-[55vh] min-h-[360px] w-full overflow-hidden">
      <img src={project.image} alt={project.title} class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
      <div class="absolute inset-0 flex flex-col justify-end px-6 sm:px-10 pb-8 sm:pb-12">
        <div class="max-w-5xl mx-auto w-full">
          <a href="/#works" class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-white/40 hover:text-white transition-colors mb-4">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
            Kembali
          </a>
          <span class="block text-terracotta text-[11px] font-bold uppercase tracking-[0.2em] mb-2">{project.categoryName}</span>
          <h1 class="font-heading font-black text-3xl sm:text-4xl md:text-5xl text-white leading-[1.1] max-w-3xl">{project.title}</h1>
        </div>
      </div>
    </section>

    <!-- CONTENT -->
    <section class="max-w-2xl mx-auto px-6 py-14 sm:py-20">
      <p class="text-slate-400 text-xs mb-8">Client — <span class="text-navy font-semibold">{project.client}</span></p>

      <div class="space-y-10">
        <div>
          <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-300 mb-2">Challenge</h2>
          <p class="text-slate-600 leading-[1.8]">{project.challenge}</p>
        </div>
        <div>
          <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-300 mb-2">Strategy</h2>
          <p class="text-slate-600 leading-[1.8]">{project.strategy}</p>
        </div>
        <div>
          <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-300 mb-2">Result</h2>
          <p class="text-slate-600 leading-[1.8]">{project.result}</p>
        </div>
      </div>

      <div class="mt-14 pt-8 border-t border-slate-100 flex gap-3">
        <a href="/#works" class="px-5 py-2.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-500 hover:border-navy hover:text-navy transition-colors">Proyek Lainnya</a>
        <a href="https://wa.me/6285110511403" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg bg-terracotta hover:bg-terracotta-hover text-white text-xs font-semibold transition-colors">Hubungi Kami</a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
